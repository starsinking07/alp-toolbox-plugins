{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alp Toolbox Extension Manifest Schema",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "version",
    "category",
    "runtime",
    "uiSlot",
    "platform",
    "minCoreVersion",
    "installerName",
    "installDir",
    "downloadUrl",
    "sha256",
    "payloadSha256",
    "size",
    "restartRequired"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9.-]{1,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+([.-][A-Za-z0-9]+)?$"
    },
    "category": {
      "type": "string",
      "enum": [
        "telemetry",
        "hardware",
        "ui",
        "integration",
        "utility"
      ]
    },
    "runtime": {
      "type": "string",
      "enum": [
        "optional-installer",
        "sidecar",
        "ui-module"
      ]
    },
    "uiSlot": {
      "type": "string",
      "enum": [
        "settings-extensions",
        "sidebar-page",
        "tray-menu",
        "none"
      ]
    },
    "platform": {
      "type": "string",
      "enum": [
        "windows-amd64"
      ]
    },
    "minCoreVersion": {
      "type": "string",
      "minLength": 1
    },
    "installerName": {
      "type": "string",
      "pattern": "\\.exe$"
    },
    "installDir": {
      "type": "string",
      "minLength": 1
    },
    "homepage": {
      "type": "string",
      "pattern": "^https://"
    },
    "downloadUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "payloadSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "size": {
      "type": "integer",
      "minimum": 1
    },
    "restartRequired": {
      "type": "boolean"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
