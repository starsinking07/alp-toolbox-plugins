{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Alp Toolbox Plugins Catalog Schema",
  "type": "object",
  "required": [
    "schemaVersion",
    "updatedAt",
    "repository",
    "mainRepository",
    "branch",
    "plugins"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "updatedAt": {
      "type": "string",
      "minLength": 10
    },
    "repository": {
      "type": "string",
      "pattern": "^https://"
    },
    "mainRepository": {
      "type": "string",
      "pattern": "^https://"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "./plugin.schema.json"
      }
    }
  }
}
